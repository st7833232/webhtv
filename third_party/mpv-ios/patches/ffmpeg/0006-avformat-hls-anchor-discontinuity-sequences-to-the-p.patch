+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61360000, 61298667, 61360000, 61298667) ||
+        check_timestamp("audio decides", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61378667) ||
+        check_timestamp("follower video", MAPSEG(&video, 1320000, 0, 1, 60000000), 61400000) ||
+        check_timestamp("follower offset", state.offset, 60080000) ||
+        check_timestamp("audio after", MAPSEG(&audio, 1400000, aframe, 1, 60000000), 61480000))
