+            reset_segment_marks(pls);
         }
 
         /*
@@ -2598,6 +2671,7 @@ static int normalize_playlist_timestamp(HLSContext *c, struct playlist *pls)
     int64_t mapped_dts;
     int64_t packet_offset;
     int64_t old_offset;
+    const struct segment_mark *mark = NULL;
     int ret;
 
     if (!pls->has_discontinuity || pls->pkt->dts == AV_NOPTS_VALUE)
@@ -2616,8 +2690,17 @@ static int normalize_playlist_timestamp(HLSContext *c, struct playlist *pls)
     dts = av_rescale_q(pls->pkt->dts, time_base, AV_TIME_BASE_Q);
     duration = av_rescale_q(pls->pkt->duration, time_base, AV_TIME_BASE_Q);
     stream_state = &pls->stream_timestamp_states[pls->pkt->stream_index];
+    /* A playlist that will not change has a fixed EXTINF timeline (RFC 8216
+     * section 6.3.3), which is what seeking uses: anchor each discontinuity
+     * sequence to it. Live playlists keep continuity-only mapping. */
+    if (!pls->timestamp_mode)
+        pls->timestamp_mode = pls->finished ? 2 : 1;
+    if (pls->timestamp_mode == 2)
+        mark = find_segment_mark(pls, pls->pkt->pos);
+    /* On the playlist timeline, a packet attributed to its segment has its
+     * baseline measured against that segment's start instead. */
     if (stream_state->baseline == AV_NOPTS_VALUE &&
-        c->first_timestamp != AV_NOPTS_VALUE) {
+        c->first_timestamp != AV_NOPTS_VALUE && !mark) {
         if (pls->timestamp_state.segment_start == AV_NOPTS_VALUE)
             stream_state->baseline = av_sat_sub64(dts, c->first_timestamp);
         else
@@ -2628,8 +2711,43 @@ static int normalize_playlist_timestamp(HLSContext *c, struct playlist *pls)
     discontinuity_threshold = FFMAX(av_sat_add64(pls->target_duration,
                                                  pls->target_duration),
                                     AV_TIME_BASE);
-    mapped_dts = ff_hls_timestamp_map(&pls->timestamp_state, stream_state,
-                                      dts, duration, discontinuity_threshold);
+    if (pls->timestamp_mode == 2) {
+        FFHLSTimestampSegment seg = {
+            .sequence       = AV_NOPTS_VALUE,
+            .start          = AV_NOPTS_VALUE,
+            .tolerance      = HLS_REANCHOR_TOLERANCE,
+            .baseline       = get_timestamp_baseline(pls, -1),
+            .strict         = stream->codecpar->codec_type == AVMEDIA_TYPE_VIDEO,
+            .may_anchor     = 1,
+            .playlist_start = c->first_timestamp,
+        };
+
+        if (mark) {
+            seg.sequence = mark->sequence;
+            if (c->first_timestamp != AV_NOPTS_VALUE)
+                seg.start = av_sat_add64(c->first_timestamp, mark->start);
+        }
+        /* After a seek, anchor on the seek stream's first packet: the other
+         * streams' packets before it are dropped anyway, and its keyframe
+         * then maps exactly onto the discard threshold. */
+        if (pls->seek_timestamp != AV_NOPTS_VALUE &&
+            pls->seek_stream_index >= 0 &&
+            pls->seek_stream_index != pls->pkt->stream_index &&
+            pls->seek_stream_index < pls->ctx->nb_streams) {
+            enum AVMediaType type =
+                pls->ctx->streams[pls->seek_stream_index]->codecpar->codec_type;
+            seg.may_anchor = type != AVMEDIA_TYPE_AUDIO &&
+                             type != AVMEDIA_TYPE_VIDEO;
+        }
+        mapped_dts = ff_hls_timestamp_map_segment(&pls->timestamp_state,
+                                                  stream_state, dts, duration,
+                                                  discontinuity_threshold,
+                                                  &seg);
+    } else {
+        mapped_dts = ff_hls_timestamp_map(&pls->timestamp_state, stream_state,
+                                          dts, duration,
+                                          discontinuity_threshold);
+    }
     if (pls->timestamp_state.offset != old_offset)
         av_log(pls->parent, AV_LOG_VERBOSE,
                "HLS timestamp discontinuity in playlist %d: offset %"PRId64" -> %"PRId64"\n",
@@ -2723,6 +2841,11 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
                     ts_diff = av_rescale_rnd(pls->pkt->dts, AV_TIME_BASE,
                                             tb.den, AV_ROUND_DOWN) -
                             pls->seek_timestamp;
+                    /* Normalized timestamps are rounded to the nearest tick,
+                     * so compare them in their own time base. */
+                    if (pls->has_discontinuity)
+                        ts_diff = ff_hls_timestamp_reached(pls->pkt->dts, tb,
+                                                           pls->seek_timestamp) ? 0 : -1;
                     if (ts_diff >= 0 && (pls->seek_flags  & AVSEEK_FLAG_ANY ||
                                         pls->pkt->flags & AV_PKT_FLAG_KEY)) {
                         pls->seek_timestamp = AV_NOPTS_VALUE;
@@ -2883,6 +3006,7 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
         pb->buf_end = pb->buf_ptr = pb->buffer;
         /* Reset the pos, to let the mpegts/mov demuxer know we've seeked. */
         pb->pos = 0;
+        reset_segment_marks(pls);
         /* Flush the packet queue of the subdemuxer. */
         if (pls->ctx)
             ff_read_frame_flush(pls->ctx);
diff --git a/libavformat/hls_timestamp.c b/libavformat/hls_timestamp.c
index 37fec7b309..a09af7193a 100644
--- a/libavformat/hls_timestamp.c
+++ b/libavformat/hls_timestamp.c
@@ -16,9 +16,14 @@
  */
 
 #include "libavutil/common.h"
+#include "libavutil/mathematics.h"
 
 #include "hls_timestamp.h"
 
+/* Largest gap from a stream's continuity across a tag that still counts as
+ * continuous (1.5 frames at 25 fps). */
+#define HLS_CONTINUITY_MAX (AV_TIME_BASE * 3 / 50)
+
 static int is_timestamp_discontinuous(int64_t timestamp, int64_t reference,
                                       int64_t threshold)
 {
@@ -31,6 +36,9 @@ void ff_hls_timestamp_init(FFHLSTimestampState *state)
     state->offset        = 0;
     state->segment_start = AV_NOPTS_VALUE;
     state->last_dts      = AV_NOPTS_VALUE;
+    state->sequence      = AV_NOPTS_VALUE;
+    state->prev_offset   = 0;
+    state->decided_start = AV_NOPTS_VALUE;
 }
 
 void ff_hls_timestamp_stream_init(FFHLSTimestampStreamState *state)
@@ -38,6 +46,10 @@ void ff_hls_timestamp_stream_init(FFHLSTimestampStreamState *state)
     state->baseline      = AV_NOPTS_VALUE;
     state->last_dts      = AV_NOPTS_VALUE;
     state->last_duration = 0;
+    state->last_step     = 0;
+    state->sequence      = AV_NOPTS_VALUE;
+    state->offset        = 0;
+    state->segment_start = AV_NOPTS_VALUE;
 }
 
 void ff_hls_timestamp_reset(FFHLSTimestampState *state,
@@ -47,10 +59,16 @@ void ff_hls_timestamp_reset(FFHLSTimestampState *state,
     state->offset        = 0;
     state->segment_start = segment_start;
     state->last_dts      = AV_NOPTS_VALUE;
+    state->sequence      = AV_NOPTS_VALUE;
+    state->prev_offset   = 0;
+    state->decided_start = AV_NOPTS_VALUE;
 
     for (int i = 0; i < nb_streams; i++) {
         streams[i].last_dts      = AV_NOPTS_VALUE;
         streams[i].last_duration = 0;
+        streams[i].last_step     = 0;
+        streams[i].sequence      = AV_NOPTS_VALUE;
+        streams[i].segment_start = AV_NOPTS_VALUE;
     }
 }
 
@@ -93,3 +111,240 @@ int64_t ff_hls_timestamp_map(FFHLSTimestampState *state,
         state->last_dts = mapped;
     return mapped;
 }
+
+/* Spacing expected after the stream's last packet: its duration, or the last
+ * dts step when the demuxer leaves durations unset (MPEG-TS video). */
+static int64_t stream_step(const FFHLSTimestampStreamState *stream)
+{
+    if (stream->last_duration > 0)
+        return stream->last_duration;
+    return FFMAX(stream->last_step, 1);
+}
+
+/* ff_hls_timestamp_map() continuity rule on one of the offsets. */
+static int64_t map_continuous(FFHLSTimestampState *state,
+                              FFHLSTimestampStreamState *stream,
+                              int64_t *offset, int64_t dts,
+                              int64_t discontinuity_threshold)
+{
+    int64_t mapped = av_sat_add64(dts, *offset);
+
+    if (stream->last_dts != AV_NOPTS_VALUE) {
+        int64_t expected = av_sat_add64(stream->last_dts, stream_step(stream));
+
+        if (is_timestamp_discontinuous(mapped, expected, discontinuity_threshold) &&
+            (state->last_dts == AV_NOPTS_VALUE ||
+             is_timestamp_discontinuous(mapped, state->last_dts,
+                                        discontinuity_threshold))) {
+            *offset = av_sat_add64(*offset, av_sat_sub64(expected, mapped));
+            mapped = expected;
+        }
+        mapped = FFMAX(mapped, stream->last_dts);
+    }
+    return mapped;
+}
+
+static int64_t update_stream(FFHLSTimestampState *state,
+                             FFHLSTimestampStreamState *stream,
+                             int64_t mapped, int64_t duration,
+                             int64_t sequence, int first_in_sequence,
+                             int64_t offset, const FFHLSTimestampSegment *seg)
+{
+    if (!first_in_sequence && stream->last_dts != AV_NOPTS_VALUE &&
+        mapped > stream->last_dts)
+        stream->last_step = mapped - stream->last_dts;
+    stream->last_dts      = mapped;
+    stream->last_duration = duration;
+    stream->offset        = offset;
+    stream->segment_start = seg->start;
+    if (sequence != AV_NOPTS_VALUE)
+        stream->sequence = sequence;
+    if (state->last_dts == AV_NOPTS_VALUE || mapped > state->last_dts)
+        state->last_dts = mapped;
+    return mapped;
+}
+
+/* Baseline of a stream at its first packet: its offset to its own segment
+ * start on the mapped timeline. For a stream present from the playlist start
+ * this is dts - first timestamp; a stream that appears later, possibly on
+ * another clock, gets the same relation to its segment instead of its
+ * distance to the playlist start. That is only a baseline if the packet is at
+ * its segment start, so after the playlist's first segment a measurement
+ * more than a tenth of the tolerance from the playlist's own baseline (a
+ * stream starting mid-segment) is replaced by that baseline. */
+static void measure_baseline(FFHLSTimestampStreamState *stream, int64_t mapped,
+                             const FFHLSTimestampSegment *seg)
+{
+    int64_t measured, limit = seg->tolerance;
+
+    if (stream->baseline != AV_NOPTS_VALUE || seg->start == AV_NOPTS_VALUE)
+        return;
+    if (seg->playlist_start != AV_NOPTS_VALUE && seg->start > seg->playlist_start)
+        limit /= 10;
+    measured = av_sat_sub64(mapped, seg->start);
+    stream->baseline = is_timestamp_discontinuous(measured, seg->baseline,
+                                                  limit) ?
+                       seg->baseline : measured;
+}
+
+/* Measure the baseline of a non-strict stream again at a packet that is
+ * expected near its segment start; only a value within tolerance / 10 of the
+ * playlist's own baseline is taken. */
+static void remeasure_baseline(FFHLSTimestampStreamState *stream, int64_t mapped,
+                               const FFHLSTimestampSegment *seg)
+{
+    int64_t measured = av_sat_sub64(mapped, seg->start);
+
+    if (!is_timestamp_discontinuous(measured, seg->baseline, seg->tolerance / 10))
+        stream->baseline = measured;
+}
+
+int64_t ff_hls_timestamp_map_segment(FFHLSTimestampState *state,
+                                     FFHLSTimestampStreamState *stream,
+                                     int64_t dts, int64_t duration,
+                                     int64_t discontinuity_threshold,
+                                     const FFHLSTimestampSegment *seg)
+{
+    int64_t sequence, mapped;
+
+    if (dts == AV_NOPTS_VALUE)
+        return dts;
+
+    sequence = seg->sequence != AV_NOPTS_VALUE ? seg->sequence : stream->sequence;
+
+    if (state->segment_start != AV_NOPTS_VALUE) {
+        /* Seek anchor. Packets of other streams read before the seek
+         * stream are dropped by the caller; do not let them take it. The
+         * anchor is the packet's own segment start, which is the seek
+         * segment unless that segment has no packet of this stream. */
+        int64_t start = seg->start != AV_NOPTS_VALUE ? seg->start :
+                        state->segment_start;
+
+        if (!seg->may_anchor)
+            return av_sat_add64(dts, state->offset);
+        if (stream->baseline == AV_NOPTS_VALUE)
+            stream->baseline = seg->baseline;
+        state->offset        = av_sat_sub64(av_sat_add64(start, stream->baseline),
+                                            dts);
+        state->prev_offset   = state->offset;
+        state->segment_start = AV_NOPTS_VALUE;
+        state->sequence      = sequence;
+        state->decided_start = start;
+        return update_stream(state, stream, av_sat_add64(dts, state->offset),
+                             duration, sequence, 1, state->offset, seg);
+    }
+
+    if (state->sequence == AV_NOPTS_VALUE)
+        state->sequence = sequence;
+    if (sequence == AV_NOPTS_VALUE)
+        sequence = state->sequence;
+
+    if (sequence != AV_NOPTS_VALUE && sequence > state->sequence) {
+        /* First packet delivered from a new discontinuity sequence: it
+         * decides the offset of the whole sequence. */
+        int64_t baseline = stream->baseline != AV_NOPTS_VALUE ?
+                           stream->baseline : seg->baseline;
+        int64_t target   = seg->start == AV_NOPTS_VALUE ? AV_NOPTS_VALUE :
+                           av_sat_add64(seg->start, baseline);
+        int64_t last     = stream->last_dts;
+        int64_t step     = stream_step(stream);
+        int64_t next     = last == AV_NOPTS_VALUE ? AV_NOPTS_VALUE :
+                           av_sat_add64(last, step);
+        /* Continuity across a tag holds within a frame; allow half a frame
+         * of jitter, but no more than 60 ms: at low frame rates 1.5 frames
+         * would keep a splice 100-120 ms off, and the offset kept passes on
+         * to the content after it. */
+        int64_t cont     = FFMIN3(av_sat_add64(step, step / 2), seg->tolerance,
+                                  HLS_CONTINUITY_MAX);
+        int keep         = target == AV_NOPTS_VALUE;
+
+        state->prev_offset   = state->offset;
+        state->sequence      = sequence;
+        state->decided_start = seg->start;
+        mapped = av_sat_add64(dts, state->offset);
+
+        /* Keep the offset if the packet continues its stream across the tag,
+         * or nearly continues it while its playlist position is further off
+         * (EXTINF drift). Otherwise re-anchor it onto that position. */
+        if (!keep && next != AV_NOPTS_VALUE)
+            keep = !is_timestamp_discontinuous(mapped, next, cont) ||
+                   (mapped > last &&
+                    !is_timestamp_discontinuous(mapped, next, seg->tolerance) &&
+                    is_timestamp_discontinuous(mapped, target, seg->tolerance));
+        if (!keep)
+            mapped = target;
+        /* Never move the deciding stream back: it may overlap the previous
+         * sequence by less than a packet, as a continuous splice does, but
+         * never for a strict stream. */
+        if (last != AV_NOPTS_VALUE &&
+            mapped <= (seg->strict ? last : av_sat_sub64(last, step)))
+            mapped = next;
+        state->offset = av_sat_sub64(mapped, dts);
+        measure_baseline(stream, mapped, seg);
+        return update_stream(state, stream, mapped, duration, sequence, 1,
+                             state->offset, seg);
+    }
+
+    if (sequence != AV_NOPTS_VALUE && sequence < state->sequence) {
+        /* Late packet of an earlier sequence (demuxer/parser delay): the
+         * offset its stream last used in that sequence, which is not the
+         * previous sequence's when the stream was held across a sequence
+         * without it; else the previous sequence's. */
+        int64_t *offset = stream->last_dts != AV_NOPTS_VALUE &&
+                          stream->sequence == sequence ?
+                          &stream->offset : &state->prev_offset;
+
+        mapped = map_continuous(state, stream, offset, dts,
+                                discontinuity_threshold);
+        measure_baseline(stream, mapped, seg);
+        return update_stream(state, stream, mapped, duration, sequence, 0,
+                             *offset, seg);
+    }
+
+    if (sequence != AV_NOPTS_VALUE && stream->sequence != sequence) {
+        /* First packet of this stream in a sequence another stream has
+         * already decided: same offset, which keeps the segment's own A/V
+         * relation; a splice overlap passes through as it would on a
+         * continuous splice. */
+        mapped = av_sat_add64(dts, state->offset);
+        /* A strict stream still never steps back: move the shared offset on,
+         * so the rest of the sequence keeps this relation. */
+        if (seg->strict && stream->last_dts != AV_NOPTS_VALUE &&
+            mapped <= stream->last_dts) {
+            int64_t next = av_sat_add64(stream->last_dts, stream_step(stream));
+
+            state->offset = av_sat_add64(state->offset, av_sat_sub64(next, mapped));
+            mapped        = next;
+        }
+        /* A non-strict stream measures its baseline again in the segment of
+         * the packet that decided or seek-anchored the sequence, where it
+         * starts with the other stream: a start delay inside the playlist's
+         * first segment does not persist into the sequences it decides. */
+        if (!seg->strict && stream->baseline != AV_NOPTS_VALUE &&
+            seg->start != AV_NOPTS_VALUE && seg->start == state->decided_start)
+            remeasure_baseline(stream, mapped, seg);
+        measure_baseline(stream, mapped, seg);
+        return update_stream(state, stream, mapped, duration, sequence, 1,
+                             state->offset, seg);
+    }
+
+    mapped = map_continuous(state, stream, &state->offset, dts,
+                            discontinuity_threshold);
+    /* A baseline more than tolerance / 10 from the playlist's can only have
+     * been measured in the first segment, as a start delay; measure it again
+     * at the stream's first packet in each later segment until it fits. */
+    if (!seg->strict && stream->baseline != AV_NOPTS_VALUE &&
+        seg->start != AV_NOPTS_VALUE && stream->segment_start != AV_NOPTS_VALUE &&
+        seg->start != stream->segment_start &&
+        is_timestamp_discontinuous(stream->baseline, seg->baseline,
+                                   seg->tolerance / 10))
+        remeasure_baseline(stream, mapped, seg);
+    measure_baseline(stream, mapped, seg);
+    return update_stream(state, stream, mapped, duration, sequence, 0,
+                         state->offset, seg);
+}
+
+int ff_hls_timestamp_reached(int64_t dts, AVRational tb, int64_t threshold)
+{
+    return dts >= av_rescale_q_rnd(threshold, AV_TIME_BASE_Q, tb, AV_ROUND_DOWN);
+}
