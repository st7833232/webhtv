+/* Playlist-timeline mapping (ff_hls_timestamp_map_segment()), microseconds.
+ * first_timestamp 1.32 s (first video dts), audio baseline 58667 us, as in
+ * 25 fps H.264 + 48 kHz AAC MPEG-TS whose PTS start at 1.4 s. MPEG-TS video
+ * packets carry no duration at this layer. */
+static const int64_t first_ts = 1320000;
+static const int64_t abase = 58667;
+static const int64_t aframe = 21333;
+
+#define MAPSEG(st, dts, dur, sq, start) \
+    map_segment(&state, st, dts, dur, sq, start, 1)
+
+/* Video packets (no duration here) are strict, audio packets are not. */
+static int64_t map_segment(FFHLSTimestampState *state,
+                           FFHLSTimestampStreamState *stream,
+                           int64_t dts, int64_t duration, int64_t sequence,
+                           int64_t start, int may_anchor)
+{
+    FFHLSTimestampSegment seg = {
+        .sequence       = sequence,
+        .start          = start == AV_NOPTS_VALUE ? AV_NOPTS_VALUE : first_ts + start,
+        .tolerance      = AV_TIME_BASE,
+        .baseline       = 0,
+        .strict         = !duration,
+        .may_anchor     = may_anchor,
+        .playlist_start = first_ts,
+    };
+    return ff_hls_timestamp_map_segment(state, stream, dts, duration,
+                                        discontinuity_threshold, &seg);
+}
+
+static void init_av(FFHLSTimestampState *state,
+                    FFHLSTimestampStreamState *video,
+                    FFHLSTimestampStreamState *audio)
