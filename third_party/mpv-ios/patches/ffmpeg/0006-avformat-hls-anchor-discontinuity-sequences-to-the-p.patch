+/* After a seek, other streams read before the seek stream do not take the
+ * anchor; the seek stream maps exactly onto its segment start. */
+static int test_segment_seek_anchor(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState streams[2];
+
+    init_av(&state, &streams[0], &streams[1]);
+    ff_hls_timestamp_reset(&state, streams, 2, first_ts + 76000000);
+    if (check_timestamp("pre-anchor audio", map_segment(&state, &streams[1], 1400000, aframe, 2, 76000000, 0), 1400000) ||
+        check_timestamp("anchor pending", state.segment_start, first_ts + 76000000) ||
+        check_timestamp("anchor video", MAPSEG(&streams[0], 1320000, 0, 2, 76000000), first_ts + 76000000) ||
+        check_timestamp("anchored audio", MAPSEG(&streams[1], 1400000, aframe, 2, 76000000), 77400000))
+        return 1;
+    /* The seek segment has no packet of the seek stream: the anchor is the
+     * start of the segment the anchoring packet comes from. */
+    init_av(&state, &streams[0], &streams[1]);
+    ff_hls_timestamp_reset(&state, streams, 2, first_ts + 76000000);
+    if (check_timestamp("audio-only segment", map_segment(&state, &streams[1], 1400000, aframe, 2, 76000000, 0), 1400000) ||
+        check_timestamp("anchor next segment", MAPSEG(&streams[0], 5320000, 0, 2, 80000000), first_ts + 80000000))
+        return 1;
+    return 0;
+}
