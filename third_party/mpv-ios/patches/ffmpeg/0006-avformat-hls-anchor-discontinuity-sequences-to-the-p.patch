+/* XVPRE: video-only pre-roll, then A/V content on the 61.4 s clock, a
+ * mid-roll, and the content again, decided by audio (2 s blocks here). The
+ * audio baseline is measured in its own sequence, not against the playlist
+ * start, which would put the last block 60 s late. An audio stream first
+ * seen 2.5 s into the first segment falls back to the playlist's baseline;
+ * so does one first seen 0.6 s into a later segment (XAMID), which would
+ * otherwise place a sequence it decides 0.66 s late. */
+static int test_segment_late_stream(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    audio.baseline = AV_NOPTS_VALUE;
+    if (check_timestamp("preroll video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("preroll video 2", MAPSEG(&video, 3240000, 0, 0, 0), 3240000) ||
+        check_timestamp("preroll video 3", MAPSEG(&video, 3280000, 0, 0, 0), 3280000) ||
+        check_timestamp("content video", MAPSEG(&video, 61320000, 0, 1, 2000000), 3320000) ||
+        check_timestamp("content first audio", MAPSEG(&audio, 61378667, aframe, 1, 2000000), 3378667) ||
+        check_timestamp("late audio baseline", audio.baseline, abase) ||
+        play_tail(&state, &video, &audio, 1, 2000000, 63280000, 63368000, 5280000, 5368000) ||
+        check_timestamp("midroll video", MAPSEG(&video, 1320000, 0, 2, 4000000), 5320000) ||
+        play_tail(&state, &video, &audio, 2, 4000000, 3280000, 3368000, 7280000, 7368000) ||
+        check_timestamp("resume audio decides", MAPSEG(&audio, 63378667, aframe, 3, 6000000), 7378667) ||
+        check_timestamp("resume video", MAPSEG(&video, 63320000, 0, 3, 6000000), 7320000))
+        return 1;
+    init_av(&state, &video, &audio);
+    audio.baseline = AV_NOPTS_VALUE;
+    if (check_timestamp("video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("audio 2.5 s in", MAPSEG(&audio, 3820000, aframe, 0, 0), 3820000) ||
+        check_timestamp("implausible baseline", audio.baseline, 0))
+        return 1;
+    init_av(&state, &video, &audio);
+    audio.baseline = AV_NOPTS_VALUE;
+    if (check_timestamp("segment 1 video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("segment 2 video", MAPSEG(&video, 9320000, 0, 0, 8000000), 9320000) ||
+        check_timestamp("audio 0.6 s in", MAPSEG(&audio, 9978667, aframe, 0, 8000000), 9978667) ||
+        check_timestamp("mid-segment baseline", audio.baseline, 0) ||
+        play_tail(&state, &video, &audio, 0, 8000000, 11280000, 11389333, 11280000, 11389333) ||
+        check_timestamp("cut decided by audio", MAPSEG(&audio, 61378667, aframe, 1, 12000000), first_ts + 12000000) ||
+        check_timestamp("cut video", MAPSEG(&video, 61320000, 0, 1, 12000000), first_ts + 12000000 - abase))
+        return 1;
+    return 0;
+}
+
+/* XAMID1: audio starts 0.6 s after video inside the playlist's FIRST segment,
+ * which keeps that start delay as its baseline. It is measured again where the
+ * audio starts with the video: in the deciding segment of an ad that video
+ * decided, so the cut after the ad that audio decides lands on its position,
+ * not 0.6 s late. XAMID1N: without the ad, at its first packet of the next
+ * segment. */
+static int test_segment_first_segment_delay(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    audio.baseline = AV_NOPTS_VALUE;
+    if (check_timestamp("video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("audio 0.6 s in", MAPSEG(&audio, 1978667, aframe, 0, 0), 1978667) ||
+        check_timestamp("start delay baseline", audio.baseline, 600000 + abase) ||
+        play_tail(&state, &video, &audio, 0, 8000000, 11280000, 11389333, 11280000, 11389333) ||
+        check_timestamp("ad video decides", MAPSEG(&video, 1320000, 0, 1, 12000000), first_ts + 12000000) ||
+        check_timestamp("ad audio", MAPSEG(&audio, 1378667, aframe, 1, 12000000), first_ts + 12000000 + abase) ||
+        check_timestamp("baseline measured in the ad", audio.baseline, abase) ||
+        play_tail(&state, &video, &audio, 1, 12000000, 5280000, 5389333, 17280000, 17389333) ||
+        check_timestamp("cut decided by audio", MAPSEG(&audio, 61378667, aframe, 2, 16000000), first_ts + 16000000 + abase) ||
+        check_timestamp("cut video", MAPSEG(&video, 61320000, 0, 2, 16000000), first_ts + 16000000))
+        return 1;
+    init_av(&state, &video, &audio);
+    audio.baseline = AV_NOPTS_VALUE;
+    if (check_timestamp("no ad: video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("no ad: audio 0.6 s in", MAPSEG(&audio, 1978667, aframe, 0, 0), 1978667) ||
+        check_timestamp("no ad: segment 2 video", MAPSEG(&video, 5320000, 0, 0, 4000000), 5320000) ||
+        check_timestamp("no ad: segment 2 audio", MAPSEG(&audio, 5378667, aframe, 0, 4000000), 5378667) ||
+        check_timestamp("baseline measured in segment 2", audio.baseline, abase) ||
+        play_tail(&state, &video, &audio, 0, 4000000, 7280000, 7389333, 7280000, 7389333) ||
+        check_timestamp("no ad: cut decided by audio", MAPSEG(&audio, 61378667, aframe, 1, 8000000), first_ts + 8000000 + abase) ||
+        check_timestamp("no ad: cut video", MAPSEG(&video, 61320000, 0, 1, 8000000), first_ts + 8000000))
+        return 1;
+    return 0;
+}
