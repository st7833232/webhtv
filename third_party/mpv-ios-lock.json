    "project": "MPVKit",
    "repo": "https://github.com/mpvkit/MPVKit",
    "release": "1.0.0",
    "release_commit": "288527dffbc6d3e63cce147fc7b520c64a791603",
    "build_commit": "9d057f9c19fa704e242b199d26bc6c5cf23dd5d6",
    "build_commit_note": "The 1.0.0 binaries were built from build_commit; release_commit only changes Package.swift.",
    "arguments": [
      "build",
      "platform=ios"
    ],
    "arguments_note": "No enable-gpl, so libmpv is configured with -Dgpl=false: the LGPL MPVKit product, as IOS-POC-9A requires. platform=ios builds ios arm64 plus the arm64 and x86_64 simulator.",
    "workdir": "/Users/runner/work/MPVKit/MPVKit",
    "workdir_note": "The directory the 1.0.0 release was built in. It appears in libmpv's embedded Configuration string, so building there lets that string be compared byte for byte."
