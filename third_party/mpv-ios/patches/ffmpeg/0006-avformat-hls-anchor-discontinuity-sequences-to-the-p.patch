 libavformat/hls.c                 | 118 ++++++++++++++-
 libavformat/hls_timestamp.c       | 149 +++++++++++++++++++
 libavformat/hls_timestamp.h       |  63 ++++++++
 libavformat/tests/hls_timestamp.c | 240 +++++++++++++++++++++++++++++-
 4 files changed, 561 insertions(+), 9 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index ebd70c14f3..b253dfee19 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -51,6 +51,11 @@
 
 #define INITIAL_BUFFER_SIZE 32768
 
+/* A new discontinuity sequence of a finished playlist is re-anchored to its
+ * playlist position only if it is more than this far from it (and from its
+ * own continuity). */
+#define HLS_REANCHOR_TOLERANCE AV_TIME_BASE
+
 #define MAX_FIELD_LEN 64
 #define MAX_CHARACTERISTICS_LEN 512
 
@@ -85,6 +90,15 @@ struct segment {
     uint8_t iv[16];
     /* associated Media Initialization Section, treated as a segment */
     struct segment *init_section;
+    int discontinuity; /* preceded by EXT-X-DISCONTINUITY */
+};
+
+/* Where a segment opened by read_data_continuous() starts in the playlist's
+ * byte stream, so a demuxed packet can be attributed to its segment. */
+struct segment_mark {
+    int64_t pos;      /* byte position in pls->pb */
+    int64_t sequence; /* discontinuity sequence of the segment */
+    int64_t start;    /* sum of the EXTINF durations before the segment */
 };
 
 struct rendition;
@@ -166,6 +180,10 @@ struct playlist {
     FFHLSTimestampState timestamp_state;
     FFHLSTimestampStreamState *stream_timestamp_states;
     int n_stream_timestamp_states;
+    int timestamp_mode; /* 0 unset, 1 continuity (live), 2 playlist timeline */
+    int64_t io_pos;     /* bytes handed to pb since it was last reset */
+    struct segment_mark seg_marks[32];
+    int n_seg_marks;    /* marks recorded since pb was last reset */
     int64_t seek_timestamp;
     int seek_flags;
     int seek_stream_index; /* into subdemuxer stream array */
@@ -1090,6 +1108,7 @@ static int parse_playlist(HLSContext *c, const char *url,
                 }
                 seg->duration = duration;
                 seg->key_type = key_type;
+                seg->discontinuity = discontinuity;
                 pls->has_discontinuity |= discontinuity;
                 dynarray_add(&pls->segments, &pls->n_segments, seg);
                 is_segment = 0;
@@ -1667,6 +1686,47 @@ reload:
     return ret;
 }
 
+static void reset_segment_marks(struct playlist *pls)
+{
+    pls->io_pos      = 0;
+    pls->n_seg_marks = 0;
+}
+
+static void mark_segment_start(struct playlist *pls)
+{
+    int64_t n = pls->cur_seq_no - pls->start_seq_no;
+    int64_t start = 0, sequence = 0;
+    struct segment_mark *m;
+
+    if (n < 0 || n >= pls->n_segments)
+        return;
+    for (int64_t i = 0; i <= n; i++) {
+        sequence += pls->segments[i]->discontinuity;
+        if (i < n)
+            start += pls->segments[i]->duration;
+    }
+    m = &pls->seg_marks[pls->n_seg_marks++ % FF_ARRAY_ELEMS(pls->seg_marks)];
+    m->pos      = pls->io_pos;
+    m->sequence = sequence;
+    m->start    = start;
+}
+
+static const struct segment_mark *find_segment_mark(const struct playlist *pls,
+                                                    int64_t pos)
+{
+    int n = FFMIN(pls->n_seg_marks, FF_ARRAY_ELEMS(pls->seg_marks));
+
+    if (pos < 0)
+        return NULL;
+    for (int i = 1; i <= n; i++) {
+        const struct segment_mark *m =
+            &pls->seg_marks[(pls->n_seg_marks - i) % FF_ARRAY_ELEMS(pls->seg_marks)];
+        if (m->pos <= pos)
+            return m;
+    }
+    return NULL;
+}
+
 static int read_data_continuous(void *opaque, uint8_t *buf, int buf_size)
 {
     struct playlist *v = opaque;
@@ -1724,6 +1784,7 @@ restart:
         }
         segment_retries = 0;
         just_opened = 1;
+        mark_segment_start(v);
     }
 
     if (c->http_multiple == -1) {
@@ -1755,6 +1816,7 @@ restart:
         int copy_size = FFMIN(v->init_sec_data_len - v->init_sec_buf_read_offset, buf_size);
         memcpy(buf, v->init_sec_buf, copy_size);
         v->init_sec_buf_read_offset += copy_size;
+        v->io_pos += copy_size;
         return copy_size;
     }
 
@@ -1767,6 +1829,8 @@ restart:
             intercept_id3(v, buf, buf_size, &ret);
         }
 
+        if (ret > 0)
+            v->io_pos += ret;
         return ret;
     }
     if (c->http_persistent &&
@@ -2335,6 +2399,7 @@ static int hls_read_header(AVFormatContext *s)
             pls->pb.pub.buf_end = pls->pb.pub.buf_ptr = pls->pb.pub.buffer;
             /* Reset the position */
             pls->pb.pub.pos = 0;
+            reset_segment_marks(pls);
         }
 
         /*
@@ -2628,8 +2693,46 @@ static int normalize_playlist_timestamp(HLSContext *c, struct playlist *pls)
     discontinuity_threshold = FFMAX(av_sat_add64(pls->target_duration,
                                                  pls->target_duration),
                                     AV_TIME_BASE);
-    mapped_dts = ff_hls_timestamp_map(&pls->timestamp_state, stream_state,
-                                      dts, duration, discontinuity_threshold);
+    /* A playlist that will not change has a fixed EXTINF timeline (RFC 8216
+     * section 6.3.3), which is what seeking uses: anchor each discontinuity
+     * sequence to it. Live playlists keep continuity-only mapping. */
+    if (!pls->timestamp_mode)
+        pls->timestamp_mode = pls->finished ? 2 : 1;
+    if (pls->timestamp_mode == 2) {
+        const struct segment_mark *mark = find_segment_mark(pls, pls->pkt->pos);
+        FFHLSTimestampSegment seg = {
+            .sequence   = AV_NOPTS_VALUE,
+            .start      = AV_NOPTS_VALUE,
+            .tolerance  = HLS_REANCHOR_TOLERANCE,
+            .may_anchor = 1,
+        };
+
+        if (mark) {
+            seg.sequence = mark->sequence;
+            if (c->first_timestamp != AV_NOPTS_VALUE)
+                seg.start = av_sat_add64(c->first_timestamp, mark->start);
+        }
+        /* After a seek, anchor on the seek stream's first packet: the other
+         * streams' packets before it are dropped anyway, and its keyframe
+         * then maps exactly onto the discard threshold. */
+        if (pls->seek_timestamp != AV_NOPTS_VALUE &&
+            pls->seek_stream_index >= 0 &&
+            pls->seek_stream_index != pls->pkt->stream_index &&
+            pls->seek_stream_index < pls->ctx->nb_streams) {
+            enum AVMediaType type =
+                pls->ctx->streams[pls->seek_stream_index]->codecpar->codec_type;
+            seg.may_anchor = type != AVMEDIA_TYPE_AUDIO &&
+                             type != AVMEDIA_TYPE_VIDEO;
+        }
+        mapped_dts = ff_hls_timestamp_map_segment(&pls->timestamp_state,
+                                                  stream_state, dts, duration,
+                                                  discontinuity_threshold,
+                                                  &seg);
+    } else {
+        mapped_dts = ff_hls_timestamp_map(&pls->timestamp_state, stream_state,
+                                          dts, duration,
+                                          discontinuity_threshold);
+    }
     if (pls->timestamp_state.offset != old_offset)
         av_log(pls->parent, AV_LOG_VERBOSE,
                "HLS timestamp discontinuity in playlist %d: offset %"PRId64" -> %"PRId64"\n",
@@ -2667,7 +2770,6 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
          * stream */
         if (pls->needed && !pls->pkt->data) {
             while (1) {
-                int64_t ts_diff;
                 AVRational tb;
                 struct segment *seg = NULL;
                 if (pls->is_subtitle)
@@ -2720,11 +2822,10 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
                     }
 
                     tb = get_timebase(pls);
-                    ts_diff = av_rescale_rnd(pls->pkt->dts, AV_TIME_BASE,
-                                            tb.den, AV_ROUND_DOWN) -
-                            pls->seek_timestamp;
-                    if (ts_diff >= 0 && (pls->seek_flags  & AVSEEK_FLAG_ANY ||
-                                        pls->pkt->flags & AV_PKT_FLAG_KEY)) {
+                    if (ff_hls_timestamp_reached(pls->pkt->dts, tb,
+                                                 pls->seek_timestamp) &&
+                        (pls->seek_flags  & AVSEEK_FLAG_ANY ||
+                         pls->pkt->flags & AV_PKT_FLAG_KEY)) {
                         pls->seek_timestamp = AV_NOPTS_VALUE;
                         break;
                     }
@@ -2883,6 +2984,7 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
         pb->buf_end = pb->buf_ptr = pb->buffer;
         /* Reset the pos, to let the mpegts/mov demuxer know we've seeked. */
         pb->pos = 0;
+        reset_segment_marks(pls);
         /* Flush the packet queue of the subdemuxer. */
         if (pls->ctx)
             ff_read_frame_flush(pls->ctx);
diff --git a/libavformat/hls_timestamp.c b/libavformat/hls_timestamp.c
index 37fec7b309..5c5404fb88 100644
--- a/libavformat/hls_timestamp.c
+++ b/libavformat/hls_timestamp.c
@@ -16,6 +16,7 @@
  */
 
 #include "libavutil/common.h"
+#include "libavutil/mathematics.h"
 
 #include "hls_timestamp.h"
 
@@ -31,6 +32,8 @@ void ff_hls_timestamp_init(FFHLSTimestampState *state)
     state->offset        = 0;
     state->segment_start = AV_NOPTS_VALUE;
     state->last_dts      = AV_NOPTS_VALUE;
+    state->sequence      = AV_NOPTS_VALUE;
+    state->prev_offset   = 0;
 }
 
 void ff_hls_timestamp_stream_init(FFHLSTimestampStreamState *state)
@@ -38,6 +41,8 @@ void ff_hls_timestamp_stream_init(FFHLSTimestampStreamState *state)
     state->baseline      = AV_NOPTS_VALUE;
     state->last_dts      = AV_NOPTS_VALUE;
     state->last_duration = 0;
+    state->last_step     = 0;
+    state->sequence      = AV_NOPTS_VALUE;
 }
 
 void ff_hls_timestamp_reset(FFHLSTimestampState *state,
@@ -47,10 +52,14 @@ void ff_hls_timestamp_reset(FFHLSTimestampState *state,
     state->offset        = 0;
     state->segment_start = segment_start;
     state->last_dts      = AV_NOPTS_VALUE;
+    state->sequence      = AV_NOPTS_VALUE;
+    state->prev_offset   = 0;
 
     for (int i = 0; i < nb_streams; i++) {
         streams[i].last_dts      = AV_NOPTS_VALUE;
         streams[i].last_duration = 0;
+        streams[i].last_step     = 0;
+        streams[i].sequence      = AV_NOPTS_VALUE;
     }
 }
 
@@ -93,3 +102,143 @@ int64_t ff_hls_timestamp_map(FFHLSTimestampState *state,
         state->last_dts = mapped;
     return mapped;
 }
+
+/* Spacing expected after the stream's last packet: its duration, or the last
+ * dts step when the demuxer leaves durations unset (MPEG-TS video). */
+static int64_t stream_step(const FFHLSTimestampStreamState *stream)
+{
+    if (stream->last_duration > 0)
+        return stream->last_duration;
+    return FFMAX(stream->last_step, 1);
+}
+
+/* ff_hls_timestamp_map() continuity rule on one of the offsets. */
+static int64_t map_continuous(FFHLSTimestampState *state,
+                              FFHLSTimestampStreamState *stream,
+                              int64_t *offset, int64_t dts,
+                              int64_t discontinuity_threshold)
+{
+    int64_t mapped = av_sat_add64(dts, *offset);
+
+    if (stream->last_dts != AV_NOPTS_VALUE) {
+        int64_t expected = av_sat_add64(stream->last_dts, stream_step(stream));
+
+        if (is_timestamp_discontinuous(mapped, expected, discontinuity_threshold) &&
+            (state->last_dts == AV_NOPTS_VALUE ||
+             is_timestamp_discontinuous(mapped, state->last_dts,
+                                        discontinuity_threshold))) {
+            *offset = av_sat_add64(*offset, av_sat_sub64(expected, mapped));
+            mapped = expected;
+        }
+        mapped = FFMAX(mapped, stream->last_dts);
+    }
+    return mapped;
+}
+
+static int64_t update_stream(FFHLSTimestampState *state,
+                             FFHLSTimestampStreamState *stream,
+                             int64_t mapped, int64_t duration,
+                             int64_t sequence, int first_in_sequence)
+{
+    if (!first_in_sequence && stream->last_dts != AV_NOPTS_VALUE &&
+        mapped > stream->last_dts)
+        stream->last_step = mapped - stream->last_dts;
+    stream->last_dts      = mapped;
+    stream->last_duration = duration;
+    if (sequence != AV_NOPTS_VALUE)
+        stream->sequence = sequence;
+    if (state->last_dts == AV_NOPTS_VALUE || mapped > state->last_dts)
+        state->last_dts = mapped;
+    return mapped;
+}
+
+int64_t ff_hls_timestamp_map_segment(FFHLSTimestampState *state,
+                                     FFHLSTimestampStreamState *stream,
+                                     int64_t dts, int64_t duration,
+                                     int64_t discontinuity_threshold,
+                                     const FFHLSTimestampSegment *seg)
+{
+    int64_t baseline, sequence, mapped;
+
+    if (dts == AV_NOPTS_VALUE)
+        return dts;
+
+    baseline = stream->baseline == AV_NOPTS_VALUE ? 0 : stream->baseline;
+    sequence = seg->sequence != AV_NOPTS_VALUE ? seg->sequence : stream->sequence;
+
+    if (state->segment_start != AV_NOPTS_VALUE) {
+        /* Seek anchor. Packets of other streams read before the seek
+         * stream are dropped by the caller; do not let them take it. */
+        if (!seg->may_anchor)
+            return av_sat_add64(dts, state->offset);
+        state->offset        = av_sat_sub64(av_sat_add64(state->segment_start,
+                                                         baseline), dts);
+        state->prev_offset   = state->offset;
+        state->segment_start = AV_NOPTS_VALUE;
+        state->sequence      = sequence;
+        return update_stream(state, stream, av_sat_add64(dts, state->offset),
+                             duration, sequence, 1);
+    }
+
+    if (state->sequence == AV_NOPTS_VALUE)
+        state->sequence = sequence;
+    if (sequence == AV_NOPTS_VALUE)
+        sequence = state->sequence;
+
+    if (sequence != AV_NOPTS_VALUE && sequence > state->sequence) {
+        /* First packet delivered from a new discontinuity sequence: it
+         * decides the offset of the whole sequence. Keep the current offset
+         * if the packet is near its playlist position or continues its
+         * stream; otherwise re-anchor to the playlist timeline. */
+        int64_t target = seg->start == AV_NOPTS_VALUE ? AV_NOPTS_VALUE :
+                         av_sat_add64(seg->start, baseline);
+
+        state->prev_offset = state->offset;
+        state->sequence    = sequence;
+        mapped = av_sat_add64(dts, state->offset);
+        if (target != AV_NOPTS_VALUE &&
+            is_timestamp_discontinuous(mapped, target, seg->tolerance) &&
+            (stream->last_dts == AV_NOPTS_VALUE ||
+             is_timestamp_discontinuous(mapped,
+                                        av_sat_add64(stream->last_dts,
+                                                     stream_step(stream)),
+                                        seg->tolerance))) {
+            state->offset = av_sat_sub64(target, dts);
+            mapped        = target;
+            /* Clamping would pin more than one frame of this stream: move
+             * the anchor to one frame after its last packet instead. */
+            if (stream->last_dts != AV_NOPTS_VALUE &&
+                mapped <= av_sat_sub64(stream->last_dts, stream_step(stream))) {
+                int64_t shift = av_sat_sub64(av_sat_add64(stream->last_dts,
+                                                          stream_step(stream)),
+                                             mapped);
+                state->offset = av_sat_add64(state->offset, shift);
+                mapped        = av_sat_add64(mapped, shift);
+            }
+        }
+        return update_stream(state, stream, mapped, duration, sequence, 1);
+    }
+
+    if (sequence != AV_NOPTS_VALUE && sequence < state->sequence) {
+        /* Late packet of the previous sequence (demuxer/parser delay). */
+        mapped = map_continuous(state, stream, &state->prev_offset, dts,
+                                discontinuity_threshold);
+        return update_stream(state, stream, mapped, duration, sequence, 0);
+    }
+
+    if (sequence != AV_NOPTS_VALUE && stream->sequence != sequence)
+        /* First packet of this stream in a sequence another stream has
+         * already decided: same offset, and pass splice overlaps through
+         * unclamped as a continuous splice would be. */
+        return update_stream(state, stream, av_sat_add64(dts, state->offset),
+                             duration, sequence, 1);
+
+    mapped = map_continuous(state, stream, &state->offset, dts,
+                            discontinuity_threshold);
+    return update_stream(state, stream, mapped, duration, sequence, 0);
+}
+
+int ff_hls_timestamp_reached(int64_t dts, AVRational tb, int64_t threshold)
+{
+    return dts >= av_rescale_q_rnd(threshold, AV_TIME_BASE_Q, tb, AV_ROUND_DOWN);
+}
diff --git a/libavformat/hls_timestamp.h b/libavformat/hls_timestamp.h
index 8f7d5ad646..5107ace85b 100644
--- a/libavformat/hls_timestamp.h
+++ b/libavformat/hls_timestamp.h
@@ -24,14 +24,51 @@ typedef struct FFHLSTimestampState {
     int64_t offset;
     int64_t segment_start;
     int64_t last_dts;
+    /* Playlist-timeline mapping (ff_hls_timestamp_map_segment()) only. */
+    int64_t sequence;     ///< discontinuity sequence that offset belongs to
+    int64_t prev_offset;  ///< offset of the previous sequence, for its late packets
 } FFHLSTimestampState;
 
 typedef struct FFHLSTimestampStreamState {
     int64_t baseline;
     int64_t last_dts;
     int64_t last_duration;
+    /* Playlist-timeline mapping (ff_hls_timestamp_map_segment()) only. */
+    int64_t last_step;    ///< last positive mapped dts increment
+    int64_t sequence;     ///< discontinuity sequence of the last packet
 } FFHLSTimestampStreamState;
 
+/**
+ * Where a packet comes from in the playlist, for
+ * ff_hls_timestamp_map_segment().
+ */
+typedef struct FFHLSTimestampSegment {
+    /**
+     * Discontinuity sequence of the packet's segment (number of
+     * EXT-X-DISCONTINUITY tags up to and including it), or AV_NOPTS_VALUE
+     * if unknown, in which case the packet is taken to belong to the same
+     * sequence as the previous packet of its stream.
+     */
+    int64_t sequence;
+    /**
+     * Playlist-timeline start of the packet's segment (first timestamp plus
+     * the EXTINF durations before it, as used by seeking), or AV_NOPTS_VALUE.
+     */
+    int64_t start;
+    /**
+     * The first packet of a new sequence is re-anchored to start (plus the
+     * stream baseline) only if it deviates by more than this from both
+     * start and its own stream's continuity.
+     */
+    int64_t tolerance;
+    /**
+     * Nonzero if this packet may take a pending seek anchor. A pending
+     * anchor is kept for the seek stream; other packets read before it are
+     * mapped without touching any state (they are discarded by the caller).
+     */
+    int may_anchor;
+} FFHLSTimestampSegment;
+
 void ff_hls_timestamp_init(FFHLSTimestampState *state);
 void ff_hls_timestamp_stream_init(FFHLSTimestampStreamState *state);
 void ff_hls_timestamp_reset(FFHLSTimestampState *state,
@@ -42,4 +79,30 @@ int64_t ff_hls_timestamp_map(FFHLSTimestampState *state,
                              int64_t dts, int64_t duration,
                              int64_t discontinuity_threshold);
 
+/**
+ * Map a packet dts onto the playlist timeline (RFC 8216 section 6.3.3),
+ * for playlists that will not change (EXT-X-ENDLIST).
+ *
+ * Within a discontinuity sequence this behaves like ff_hls_timestamp_map().
+ * The first packet delivered from a new sequence decides that sequence's
+ * offset: it is re-anchored to seg->start plus its stream baseline only if
+ * it is off by more than seg->tolerance from that and from its stream's
+ * continuity; otherwise the current offset is kept. First packets of each
+ * stream in a sequence are never clamped, late packets of the previous
+ * sequence keep the previous offset, and a re-anchor that would put a stream
+ * a frame or more behind its last dts is moved forward to one frame after it.
+ */
+/**
+ * Seek discard test: nonzero if a packet dts (in tb) has reached threshold
+ * (in AV_TIME_BASE units). The threshold is rounded down to tb, so a dts
+ * mapped exactly onto it (rounded to the nearest tick) is not dropped.
+ */
+int ff_hls_timestamp_reached(int64_t dts, AVRational tb, int64_t threshold);
+
+int64_t ff_hls_timestamp_map_segment(FFHLSTimestampState *state,
+                                     FFHLSTimestampStreamState *stream,
+                                     int64_t dts, int64_t duration,
+                                     int64_t discontinuity_threshold,
+                                     const FFHLSTimestampSegment *seg);
