+        check_timestamp("audio-only ad offset", state.offset, -5000000) ||
+        check_timestamp("content audio decides", MAPSEG(&audio, 93378667, aframe, 2, 76000000), first_ts + 76000000 + abase) ||
+        check_timestamp("held content video", MAPSEG(&video, 61320000, 0, 0, 0), 61320000) ||
+        check_timestamp("content video", MAPSEG(&video, 93320000, 0, 2, 76000000), first_ts + 76000000))
+        return 1;
+    return 0;
+}
+
+/* The deciding stream never steps back. A re-anchor behind the last video
+ * dts (EXTINF understated by 60 ms before an own-clock ad) moves to one
+ * frame after it; the other stream keeps the shared offset, so only the
+ * source's sub-frame audio overlap remains. */
+static int test_segment_absorb(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61600000, 61700000, 61600000, 61700000) ||
+        check_timestamp("absorbed video", MAPSEG(&video, 1320000, 0, 1, 60000000), 61640000) ||
+        check_timestamp("absorbed video next", MAPSEG(&video, 1360000, 0, 1, 60000000), 61680000) ||
+        check_timestamp("absorbed audio", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61698667))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("understated EXTINF video", MAPSEG(&video, 1320000, 0, 1, 59940000), 61320000) ||
+        check_timestamp("understated EXTINF audio", MAPSEG(&audio, 1378667, aframe, 1, 59940000), 61378667) ||
+        check_timestamp("understated EXTINF offset", state.offset, 60000000))
+        return 1;
+    /* one frame of overlap: a sub-frame one is moved just as well */
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61340000, 61389333, 61340000, 61389333) ||
+        check_timestamp("sub-frame overlap", MAPSEG(&video, 1320000, 0, 1, 60000000), 61380000))
+        return 1;
+    return 0;
+}
+
+/* A strict stream repeating its last dts across the tag is moved one frame
+ * on. Audio, kept or re-anchored, keeps a sub-frame overlap but not a full
+ * frame; a re-anchor exactly onto the last dts is kept (one duplicate). */
+static int test_segment_keep_monotonic(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("repeated video dts", MAPSEG(&video, 61280000, 0, 1, 60000000), 61320000) ||
+        check_timestamp("repeated video offset", state.offset, 40000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("audio sub-frame overlap", MAPSEG(&audio, 61378667, aframe, 1, 60000000), 61378667))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("audio re-anchor sub-frame overlap", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61378667))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61400000, 61280000, 61400000) ||
+        check_timestamp("audio re-anchor frame overlap", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61421333))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61378667, 61280000, 61378667) ||
+        check_timestamp("audio re-anchor onto last", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61378667))
+        return 1;
+    return 0;
+}
+
+/* MPEG-TS audio reaches the demuxer without packet durations: the overlap
+ * a non-strict deciding packet may keep is then its last dts step (XALEAD:
+ * an audio re-anchor 10.7 ms behind the last packet stays on its position). */
+static int test_segment_audio_no_duration(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+    FFHLSTimestampSegment seg = {
+        .sequence       = 0,
+        .start          = first_ts,
+        .tolerance      = AV_TIME_BASE,
+        .baseline       = 0,
+        .strict         = 0,
+        .may_anchor     = 1,
+        .playlist_start = first_ts,
+    };
+
+    init_av(&state, &video, &audio);
+    for (int64_t dts = 61346667; dts <= 61389333; dts += aframe)
+        if (check_timestamp("audio tail", ff_hls_timestamp_map_segment(&state, &audio, dts, 0,
+                                                                       discontinuity_threshold, &seg), dts))
+            return 1;
+    seg.sequence = 1;
+    seg.start    = first_ts + 60000000;
+    if (check_timestamp("re-anchor overlap without duration",
+                        ff_hls_timestamp_map_segment(&state, &audio, 1378667, 0,
+                                                     discontinuity_threshold, &seg), 61378667))
+        return 1;
+    return 0;
+}
