+/* Playlist-timeline mapping (ff_hls_timestamp_map_segment()), microseconds.
+ * first_timestamp 1.32 s (first video dts), audio baseline 58667 us, as in
+ * 25 fps H.264 + 48 kHz AAC MPEG-TS whose PTS start at 1.4 s. MPEG-TS video
+ * packets carry no duration at this layer. */
+static const int64_t first_ts = 1320000;
+static const int64_t abase = 58667;
+static const int64_t aframe = 21333;
+
+#define MAPSEG(st, dts, dur, sq, start) \
+    map_segment(&state, st, dts, dur, sq, start, 1)
+
+static int64_t map_segment(FFHLSTimestampState *state,
+                           FFHLSTimestampStreamState *stream,
+                           int64_t dts, int64_t duration, int64_t sequence,
+                           int64_t start, int may_anchor)
+{
+    FFHLSTimestampSegment seg = {
+        .sequence   = sequence,
+        .start      = start == AV_NOPTS_VALUE ? AV_NOPTS_VALUE : first_ts + start,
+        .tolerance  = AV_TIME_BASE,
+        .may_anchor = may_anchor,
+    };
+    return ff_hls_timestamp_map_segment(state, stream, dts, duration,
+                                        discontinuity_threshold, &seg);
+}
+
+static void init_av(FFHLSTimestampState *state,
+                    FFHLSTimestampStreamState *video,
+                    FFHLSTimestampStreamState *audio)
+{
+    ff_hls_timestamp_init(state);
+    ff_hls_timestamp_stream_init(video);
+    ff_hls_timestamp_stream_init(audio);
+    video->baseline = 0;
+    audio->baseline = abase;
+}
+
+/* Play the last video frame and audio packet of a sequence. */
+static int play_tail(FFHLSTimestampState *state,
+                     FFHLSTimestampStreamState *video,
+                     FFHLSTimestampStreamState *audio,
+                     int64_t sequence, int64_t start, int64_t vdts, int64_t adts,
+                     int64_t vexp, int64_t aexp)
+{
+    return check_timestamp("tail video 1", map_segment(state, video, vdts - 40000, 0, sequence, start, 1), vexp - 40000) ||
+           check_timestamp("tail video 2", map_segment(state, video, vdts, 0, sequence, start, 1), vexp) ||
+           check_timestamp("tail audio", map_segment(state, audio, adts, aframe, sequence, start, 1), aexp);
+}
+
+/* L4/DALL: timestamps continuous across the tag stay untouched, including
+ * the source's sub-frame audio overlap at the splice (not clamped). */
+static int test_segment_within_tolerance(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("continuous video", MAPSEG(&video, 61320000, 0, 1, 60000000), 61320000) ||
+        check_timestamp("continuous audio overlap", MAPSEG(&audio, 61378667, aframe, 1, 60000000), 61378667) ||
+        check_timestamp("continuous audio next", MAPSEG(&audio, 61400000, aframe, 1, 60000000), 61400000) ||
+        check_timestamp("continuous offset", state.offset, 0))
+        return 1;
+    return 0;
+}
+
+/* EXTINF drift: a stream continuous across the tag is not moved even when
+ * the playlist position is more than the tolerance away; a real jump with the
+ * same drift is re-anchored to the playlist position. */
+static int test_segment_extinf_drift(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("drift continuous", MAPSEG(&video, 61320000, 0, 1, 61500000), 61320000) ||
+        check_timestamp("drift continuous offset", state.offset, 0))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("drift jump", MAPSEG(&video, 1320000, 0, 1, 61500000), first_ts + 61500000))
+        return 1;
+    return 0;
+}
+
+/* S0r: pre-roll ad (own clock 1.4 s, 16 s), then content restarting at 1.4 s:
+ * a -16 s jump, not larger than 2 * TARGETDURATION. */
+static int test_segment_preroll_reset(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (check_timestamp("preroll first video", MAPSEG(&video, 1320000, 0, 0, 0), 1320000) ||
+        check_timestamp("preroll first audio", MAPSEG(&audio, 1378667, aframe, 0, 0), 1378667) ||
+        play_tail(&state, &video, &audio, 0, 0, 17280000, 17389333, 17280000, 17389333) ||
+        check_timestamp("content reset video", MAPSEG(&video, 1320000, 0, 1, 16000000), 17320000) ||
+        check_timestamp("content reset audio", MAPSEG(&audio, 1378667, aframe, 1, 16000000), 17378667) ||
+        check_timestamp("content reset video next", MAPSEG(&video, 1360000, 0, 1, 16000000), 17360000) ||
+        check_timestamp("content reset offset", state.offset, 16000000))
+        return 1;
+    return 0;
+}
+
+/* M32: mid-roll at 32 s whose content clock skips the ad: -32 s into the ad,
+ * then +16 s back to the content, both re-anchored. */
+static int test_segment_midroll_skip(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 33280000, 33389333, 33280000, 33389333) ||
+        check_timestamp("midroll ad video", MAPSEG(&video, 1320000, 0, 1, 32000000), 33320000) ||
+        check_timestamp("midroll ad audio", MAPSEG(&audio, 1378667, aframe, 1, 32000000), 33378667) ||
+        play_tail(&state, &video, &audio, 1, 32000000, 17280000, 17389333, 49280000, 49389333) ||
+        check_timestamp("midroll content video", MAPSEG(&video, 33320000, 0, 2, 48000000), 49320000) ||
+        check_timestamp("midroll content audio", MAPSEG(&audio, 33378667, aframe, 2, 48000000), 49378667) ||
+        check_timestamp("midroll content offset", state.offset, 16000000))
+        return 1;
+    return 0;
+}
+
+/* A2r: back-to-back ads on their own clocks (-15.17 s, 30 fps), then A2c:
+ * a +28.2 s jump back to the content clock. */
+static int test_segment_backward_forward(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+    const int64_t ad_b = 75166667, content = 91800000;
+
+    init_av(&state, &video, &audio);
+    state.offset = 60000000 - 13333;          /* first ad anchored at 60 s */
+    if (check_timestamp("ad A video", MAPSEG(&video, 16433333, 0, 1, 60000000), 76420000) ||
+        check_timestamp("ad A video last", MAPSEG(&video, 16466667, 0, 1, 60000000), 76453334) ||
+        check_timestamp("ad B video (backward)", MAPSEG(&video, 1333333, 0, 2, ad_b), first_ts + ad_b) ||
+        check_timestamp("ad B offset", state.offset, first_ts + ad_b - 1333333))
+        return 1;
+    init_av(&state, &video, &audio);
+    state.offset = 60000000 - 13333;
+    if (check_timestamp("ad AB video last", MAPSEG(&video, 33100000, 0, 1, 60000000), 93086667) ||
+        check_timestamp("content video (forward)", MAPSEG(&video, 61320000, 0, 2, content), first_ts + content) ||
+        check_timestamp("content offset", state.offset, first_ts + content - 61320000))
+        return 1;
+    return 0;
+}
+
+/* The first packet of the new sequence decides; late packets of the previous
+ * sequence (parser/demuxer delay) keep the previous offset. */
+static int test_segment_late_packet(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61368000, 61280000, 61368000) ||
+        check_timestamp("ad audio first", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61378667) ||
+        check_timestamp("late content video", MAPSEG(&video, 61320000, 0, 0, 0), 61320000) ||
+        check_timestamp("ad video first", MAPSEG(&video, 1360000, 0, 1, 60000000), 61360000) ||
+        check_timestamp("ad audio next", MAPSEG(&audio, 1400000, aframe, 1, 60000000), 61400000) ||
+        /* unknown segment (no byte position): the stream's last sequence */
+        check_timestamp("unknown segment", MAPSEG(&audio, 1421333, aframe, AV_NOPTS_VALUE, AV_NOPTS_VALUE), 61421333))
+        return 1;
+    return 0;
+}
+
+/* A re-anchor that would pin more than one frame of the deciding stream is
+ * moved to one frame after its last dts; a sub-frame overlap is kept. */
+static int test_segment_absorb(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61600000, 61700000, 61600000, 61700000) ||
+        check_timestamp("absorbed video", MAPSEG(&video, 1320000, 0, 1, 60000000), 61640000) ||
+        check_timestamp("absorbed video next", MAPSEG(&video, 1360000, 0, 1, 60000000), 61680000) ||
+        check_timestamp("absorbed audio", MAPSEG(&audio, 1378667, aframe, 1, 60000000), 61698667))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61340000, 61389333, 61340000, 61389333) ||
+        check_timestamp("sub-frame overlap", MAPSEG(&video, 1320000, 0, 1, 60000000), 61320000))
+        return 1;
+    return 0;
+}
+
+/* After a seek, other streams read before the seek stream do not take the
+ * anchor; the seek stream maps exactly onto the segment start. */
+static int test_segment_seek_anchor(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState streams[2];
+
+    init_av(&state, &streams[0], &streams[1]);
+    ff_hls_timestamp_reset(&state, streams, 2, first_ts + 76000000);
+    if (check_timestamp("pre-anchor audio", map_segment(&state, &streams[1], 1400000, aframe, 2, 76000000, 0), 1400000) ||
+        check_timestamp("anchor pending", state.segment_start, first_ts + 76000000) ||
+        check_timestamp("anchor video", MAPSEG(&streams[0], 1320000, 0, 2, 76000000), first_ts + 76000000) ||
+        check_timestamp("anchored audio", MAPSEG(&streams[1], 1400000, aframe, 2, 76000000), 77400000))
+        return 1;
+    return 0;
+}
+
+/* Seek discard rounding: 76.486667 s mapped to 90 kHz rounds down by 1/3 us;
+ * the old round-down-to-us comparison dropped that keyframe. */
+static int test_seek_discard_rounding(void)
+{
+    const AVRational tb = { 1, 90000 };
+    const int64_t threshold = first_ts + 75166667;
+    int64_t dts = av_rescale_q(threshold, AV_TIME_BASE_Q, tb);
+
+    if (av_rescale_rnd(dts, AV_TIME_BASE, tb.den, AV_ROUND_DOWN) - threshold >= 0) {
+        fprintf(stderr, "rounding case does not reproduce\n");
+        return 1;
+    }
+    if (!ff_hls_timestamp_reached(dts, tb, threshold) ||
+        ff_hls_timestamp_reached(dts - 1, tb, threshold) ||
+        !ff_hls_timestamp_reached(dts + 1, tb, threshold) ||
+        !ff_hls_timestamp_reached(6840000, tb, 76000000) ||
+        ff_hls_timestamp_reached(6839999, tb, 76000000)) {
+        fprintf(stderr, "seek discard rounding\n");
+        return 1;
+    }
+    return 0;
+}
