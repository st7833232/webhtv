                 is_segment = 0;
@@ -1667,6 +1688,53 @@ reload:
     return ret;
 }
 
+static void reset_segment_marks(struct playlist *pls)
+{
+    pls->io_pos      = 0;
+    pls->n_seg_marks = 0;
+}
+
+static void mark_segment_start(struct playlist *pls)
+{
+    int64_t n = pls->cur_seq_no - pls->start_seq_no;
+    struct segment_mark *sum = &pls->mark_sum;
+    struct segment_mark *m;
+
+    /* Marks are only used on the playlist timeline: a finished playlist
+     * with discontinuities, whose segment list no longer changes. */
+    if (!pls->has_discontinuity || !pls->finished || pls->timestamp_mode == 1 ||
+        n < 0 || n >= pls->n_segments)
+        return;
+    if (n < pls->mark_sum_n) {
+        pls->mark_sum_n = 0;
+        sum->start = sum->sequence = 0;
+    }
+    for (; pls->mark_sum_n < n; pls->mark_sum_n++) {
+        sum->sequence += pls->segments[pls->mark_sum_n]->discontinuity;
+        sum->start    += pls->segments[pls->mark_sum_n]->duration;
+    }
+    m = &pls->seg_marks[pls->n_seg_marks++ % FF_ARRAY_ELEMS(pls->seg_marks)];
+    m->pos      = pls->io_pos;
+    m->sequence = sum->sequence + pls->segments[n]->discontinuity;
+    m->start    = sum->start;
+}
+
+static const struct segment_mark *find_segment_mark(const struct playlist *pls,
+                                                    int64_t pos)
+{
+    int n = FFMIN(pls->n_seg_marks, FF_ARRAY_ELEMS(pls->seg_marks));
+
+    if (pos < 0)
+        return NULL;
+    for (int i = 1; i <= n; i++) {
+        const struct segment_mark *m =
+            &pls->seg_marks[(pls->n_seg_marks - i) % FF_ARRAY_ELEMS(pls->seg_marks)];
+        if (m->pos <= pos)
+            return m;
+    }
+    return NULL;
+}
+
 static int read_data_continuous(void *opaque, uint8_t *buf, int buf_size)
 {
     struct playlist *v = opaque;
@@ -1724,6 +1792,7 @@ restart:
         }
         segment_retries = 0;
         just_opened = 1;
+        mark_segment_start(v);
