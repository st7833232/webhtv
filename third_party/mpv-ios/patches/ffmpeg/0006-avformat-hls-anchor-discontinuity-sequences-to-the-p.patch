+/* A sequence 0.8 s off its playlist position, before (XNEARE) or after
+ * (XNEARL), is re-anchored instead of kept: kept, the earlier one would step
+ * back 0.76 s. So is a sequence repeating the previous one's clock (XB2B,
+ * an ad after a 0.96 s bumper on the same clock). */
+static int test_segment_near_position(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("0.8 s early", MAPSEG(&video, 60520000, 0, 1, 60000000), 61320000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("0.8 s late", MAPSEG(&video, 62120000, 0, 1, 60000000), 61320000))
+        return 1;
+    init_av(&state, &video, &audio);
+    state.offset = 64000000;                      /* bumper anchored at 64 s */
+    if (check_timestamp("bumper last", MAPSEG(&video, 2240000, 0, 3, 64000000), first_ts + 64920000) ||
+        check_timestamp("ad on the bumper clock", MAPSEG(&video, 1320000, 0, 4, 64960000), first_ts + 64960000))
+        return 1;
+    return 0;
+}
+
+/* Which leg keeps the offset: a 0.3 s gap with the position 1.5 s away is
+ * EXTINF drift (kept); a discontinuous packet 30 ms after its position is
+ * re-anchored onto it; so is one 0.2 s from continuity and 0.3 s from the
+ * position. */
+static int test_segment_keep_legs(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("drifted near-continuous", MAPSEG(&video, 61620000, 0, 1, 61500000), 61620000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("near position", MAPSEG(&video, 61850000, 0, 1, 60500000), first_ts + 60500000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("between", MAPSEG(&video, 61520000, 0, 1, 60500000), first_ts + 60500000))
+        return 1;
+    return 0;
+}
+
+/* An ad on the content clock 80 ms off its EXTINF position (XOFFE080,
+ * XOFFL080) is two frames from continuity: it is re-anchored onto its
+ * position, and the content after it, exactly on EXTINF, is re-anchored back
+ * instead of inheriting the ad's correction. Half a frame of jitter is still
+ * continuity, and so are 1.5 frames at 25 fps (60 ms, XOFFL060), but at
+ * 12.5 fps 1.5 frames (120 ms, XK2L12) are a splice: the window is at most
+ * 60 ms. */
+static int test_segment_continuity(void)
+{
+    FFHLSTimestampState state;
+    FFHLSTimestampStreamState video, audio;
+
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("80 ms late", MAPSEG(&video, 61400000, 0, 1, 60000000), 61320000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("60 ms late at 25 fps", MAPSEG(&video, 61380000, 0, 1, 60000000), 61380000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (check_timestamp("12.5 fps video 1", MAPSEG(&video, 61160000, 0, 0, 0), 61160000) ||
+        check_timestamp("12.5 fps video 2", MAPSEG(&video, 61240000, 0, 0, 0), 61240000) ||
+        check_timestamp("120 ms late at 12.5 fps", MAPSEG(&video, 61440000, 0, 1, 60000000), 61320000) ||
+        check_timestamp("12.5 fps ad offset", state.offset, -120000))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("80 ms early", MAPSEG(&video, 61240000, 0, 1, 60000000), 61320000) ||
+        check_timestamp("early ad offset", state.offset, 80000) ||
+        play_tail(&state, &video, &audio, 1, 60000000, 63200000, 63309333, 63280000, 63389333) ||
+        check_timestamp("content on EXTINF", MAPSEG(&video, 63320000, 0, 2, 62000000), 63320000) ||
+        check_timestamp("content offset", state.offset, 0))
+        return 1;
+    init_av(&state, &video, &audio);
+    if (play_tail(&state, &video, &audio, 0, 0, 61280000, 61389333, 61280000, 61389333) ||
+        check_timestamp("jitter", MAPSEG(&video, 61340000, 0, 1, 60500000), 61340000))
+        return 1;
+    return 0;
+}
+
+/* Audio decides a sequence on its position while the previous sequence's
+ * video ran 80 ms past it: the video's first packet would step back, so it
+ * moves one frame after its last dts and takes the shared offset along. */
