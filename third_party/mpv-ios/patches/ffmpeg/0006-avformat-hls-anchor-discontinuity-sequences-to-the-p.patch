+/* Seek discard rounding: 76.486667 s mapped to 90 kHz rounds down by 1/3 us;
+ * the old round-down-to-us comparison dropped that keyframe. */
+static int test_seek_discard_rounding(void)
+{
+    const AVRational tb = { 1, 90000 };
+    const int64_t threshold = first_ts + 75166667;
+    int64_t dts = av_rescale_q(threshold, AV_TIME_BASE_Q, tb);
+
+    if (av_rescale_rnd(dts, AV_TIME_BASE, tb.den, AV_ROUND_DOWN) - threshold >= 0) {
+        fprintf(stderr, "rounding case does not reproduce\n");
+        return 1;
+    }
+    if (!ff_hls_timestamp_reached(dts, tb, threshold) ||
+        ff_hls_timestamp_reached(dts - 1, tb, threshold) ||
+        !ff_hls_timestamp_reached(dts + 1, tb, threshold) ||
+        !ff_hls_timestamp_reached(6840000, tb, 76000000) ||
+        ff_hls_timestamp_reached(6839999, tb, 76000000)) {
+        fprintf(stderr, "seek discard rounding\n");
+        return 1;
+    }
+    return 0;
+}
